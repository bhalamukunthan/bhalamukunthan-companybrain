# Copy to .env and edit. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_MINUTES=60
MAX_UPLOAD_MB=5
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=4
# Lower = stricter. Tune with eval/eval_retrieval.py
MAX_DISTANCE=0.65
# extractive (no LLM, default) | ollama (local) | openai (external!)
LLM_PROVIDER=extractive
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Only used if LLM_PROVIDER=openai. Sends retrieved text to an external service.
ALLOW_EXTERNAL_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
